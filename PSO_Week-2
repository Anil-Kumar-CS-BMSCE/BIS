import numpy as np
import matplotlib.pyplot as plt

START = np.array([0.0, 0.0])
GOAL = np.array([10.0, 10.0])
OBSTACLE_CENTER = np.array([5.0, 5.0])
OBSTACLE_RADIUS = 2

NUM_WAYPOINTS = 5   
NUM_PARTICLES = 30  
MAX_ITERATIONS = 50 

INERTIA = 0.7
COGNITIVE_WEIGHT = 1.5
SOCIAL_WEIGHT = 1.5

def calculate_path_cost(particle_waypoints):
    full_path = np.vstack([START, particle_waypoints, GOAL])
    
    distance_cost = 0.0
    for i in range(len(full_path) - 1):
        distance_cost += np.linalg.norm(full_path[i+1] - full_path[i])
        
    safety_penalty = 0.0
    for i in range(len(full_path) - 1):
        p1 = full_path[i]
        p2 = full_path[i+1]
        for t in np.linspace(0, 1, 10):
            point_on_segment = p1 + t * (p2 - p1)
            dist_to_obstacle = np.linalg.norm(point_on_segment - OBSTACLE_CENTER)
            if dist_to_obstacle <= OBSTACLE_RADIUS:
                safety_penalty += 10000.0  
                
    return distance_cost + safety_penalty

particle_positions = np.random.uniform(0.0, 10.0, (NUM_PARTICLES, NUM_WAYPOINTS, 2))
particle_velocities = np.random.uniform(-1.0, 1.0, (NUM_PARTICLES, NUM_WAYPOINTS, 2))

personal_best_positions = np.copy(particle_positions)
personal_best_scores = np.array([calculate_path_cost(p) for p in particle_positions])

global_best_index = np.argmin(personal_best_scores)
global_best_position = np.copy(personal_best_positions[global_best_index])
global_best_score = personal_best_scores[global_best_index]

initial_best_path = np.vstack([START, global_best_position, GOAL])

for iteration in range(MAX_ITERATIONS):
    for i in range(NUM_PARTICLES):
        current_score = calculate_path_cost(particle_positions[i])
        
        if current_score < personal_best_scores[i]:
            personal_best_scores[i] = current_score
            personal_best_positions[i] = np.copy(particle_positions[i])
            
        if current_score < global_best_score:
            global_best_score = current_score
            global_best_position = np.copy(particle_positions[i])
            
    for i in range(NUM_PARTICLES):
        r1 = np.random.rand(NUM_WAYPOINTS, 2)
        r2 = np.random.rand(NUM_WAYPOINTS, 2)
        
        inertia_force = INERTIA * particle_velocities[i]
        cognitive_force = COGNITIVE_WEIGHT * r1 * (personal_best_positions[i] - particle_positions[i])
        social_force = SOCIAL_WEIGHT * r2 * (global_best_position - particle_positions[i])
        
        particle_velocities[i] = inertia_force + cognitive_force + social_force
        
        particle_positions[i] += particle_velocities[i]
        
        particle_positions[i] = np.clip(particle_positions[i], 0.0, 10.0)

final_best_path = np.vstack([START, global_best_position, GOAL])

plt.figure(figsize=(8, 8))

obstacle_circle = plt.Circle(OBSTACLE_CENTER, OBSTACLE_RADIUS, color='red', alpha=0.4, label='Obstacle')
plt.gca().add_patch(obstacle_circle)

plt.scatter([START[0], GOAL[0]], [START[1], GOAL[1]], color='black', s=100, zorder=5)
plt.text(START[0]-0.5, START[1]-0.5, "START (0,0)", fontsize=10, fontweight='bold')
plt.text(GOAL[0]-0.5, GOAL[1]+0.4, "GOAL (10,10)", fontsize=10, fontweight='bold')

plt.plot(initial_best_path[:, 0], initial_best_path[:, 1], 'r--', marker='o', label='Initial Path (May Collide)')
plt.plot(final_best_path[:, 0], final_best_path[:, 1], 'g-', marker='o', linewidth=2.5, label='Optimized Safe Path')

plt.title(f"Robot Path Planning via PSO\nFinal Path Cost: {global_best_score:.2f}", fontsize=12, fontweight='bold')
plt.xlim(-1, 11)
plt.ylim(-1, 11)
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend(loc='upper left')
plt.xlabel("X Coordinate")
plt.ylabel("Y Coordinate")

plt.show()
